      "tool": {
        "driver": {
          "fullName": "PowerApps app checker",
          "name": "PowerApps app checker",
          "rules": [
            {
              "id": "app-ErrInvalidName",
              "messageStrings": {
                "issue": {
                  "text": "Name isn't valid. '{0}' isn't recognized."
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Remove or correct the reference to the name that isn't valid."
                ],
                "level": "High",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-ErrInvalidArgs-Func",
              "messageStrings": {
                "issue": {
                  "text": "The function '{0}' has some invalid arguments."
                }
              },
              "properties": {
                "componentType": "app",
                "level": "High",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "acc-AccessibleLabelNeeded",
              "messageStrings": {
                "issue": {
                  "text": "Missing accessible label"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Edit the accessible label property to describe the item."
                ],
                "level": "Medium",
                "primaryCategory": "accessibility",
                "whyFix": "If there's no accessible text, people who can’t see the screen won't understand what’s in images and controls."
              }
            },
            {
              "id": "acc-TabIndexShouldBeDefinedForInteractiveControl",
              "messageStrings": {
                "issue": {
                  "text": "Missing tab stop"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Set TabIndex to 0 or greater to ensure that interactive elements have a tab stop."
                ],
                "level": "Medium",
                "primaryCategory": "accessibility",
                "whyFix": "People who use the keyboard with your app will not be able to access this element without a tab stop."
              }
            },
            {
              "id": "acc-FocusBorderShouldBeVisible",
              "messageStrings": {
                "issue": {
                  "text": "Focus isn't showing"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Change the FocusedBorderThickness property to be more than 0."
                ],
                "level": "Medium",
                "primaryCategory": "accessibility",
                "whyFix": "If the focus isn't visible, people who don't use a mouse won't be able to see it when they're interacting with the app."
              }
            },
            {
              "id": "app-UnusedVariables",
              "messageStrings": {
                "issue": {
                  "text": "Kullanılmayan değişken"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Kullanılmayan değişkeni kaldırın."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "Bu değişken bildirilmiş ancak herhangi bir denetim tarafından başvurulmadığından gerekli değil."
              }
            },
            {
              "id": "app-CollectingReadOnlyTable",
              "messageStrings": {
                "issue": {
                  "text": "Koleksiyon başlatıldı ama hiç güncelleştirilmedi"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Collect veya ClearCollect ifadesini App.Formulas’daki bir adlandırılmış formül ile değiştirin. Örneğin, MyTable = Filter(kaynak, koşul). Adlandırılmış formüller girişleri değiştiğinde hesaplanır ve koleksiyonun izleme maliyetini taşımaz."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "Koleksiyonlar güncelleştirmek içindir. Power Apps, veri değiştiğinde kendisine bağlı her şeyin eşitlenmiş durumda kalması için her koleksiyonu izlemek için ek iş yapar. Veri ayarlandıktan sonra hiç değişmiyorsa, bu izleme işlemi boşa gider. Adlandırılmış formül, ek maliyet olmadan aynı veriyi sağlar."
              }
            }
          ],
          "version": "1.349"
        }
      }
    }
  ],
  "version": "2.1.0"
